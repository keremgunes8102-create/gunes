# KOLTUK ortam değişkenleri — bu dosyayı .env olarak kopyalayın. Gerçek gizli anahtarları ASLA depoya eklemeyin.

# --- Zorunlu -----------------------------------------------------------------
NODE_ENV=development
# PostgreSQL 14+ bağlantısı (btree_gist ve pgcrypto eklentileri migration ile kurulur)
DATABASE_URL=postgres://koltuk:sifre@127.0.0.1:5432/koltuk
# Uygulamanın dışarıdan erişilen adresi (e-posta bağlantıları ve Origin kontrolü için)
APP_URL=http://localhost:3000

# --- Sunucu ------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Ters vekil (nginx, Cloudflare, Render vb.) arkasındaysanız 1 yapın; gerçek istemci IP'si X-Forwarded-For'dan okunur
TRUST_PROXY=0
SESSION_DAYS=30
DB_POOL_MAX=10
# Yüklenen görsellerin klasörü (kalıcı disk olmalı)
UPLOAD_DIR=data/uploads
# Zamanlanmış görevleri web süreci içinde çalıştır (1 sunucu). Birden fazla sunucuda 0 yapıp "npm run jobs" çalıştırın.
RUN_JOBS_IN_PROCESS=1
# Hesap silme talebinden sonra anonimleştirmeye kadar bekleme süresi (gün)
ACCOUNT_DELETION_GRACE_DAYS=14
# Geliştirmede doğrulama kodlarını ekranda göster (üretimde her zaman kapalıdır)
DEV_SHOW_CODES=1

# --- E-posta (isteğe bağlı) ---------------------------------------------------
# Desteklenen: resend. Boş bırakılırsa e-posta GÖNDERİLMEZ ve kayıtlar "Servis yok — gönderilmedi" olarak işaretlenir.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM="KOLTUK <bildirim@alanadiniz.com>"

# --- SMS (isteğe bağlı) -------------------------------------------------------
# Desteklenen: netgsm. Boş bırakılırsa SMS GÖNDERİLMEZ.
SMS_PROVIDER=
SMS_USERNAME=
SMS_PASSWORD=
SMS_HEADER=

# --- Yalnızca test / betikler --------------------------------------------------
# TEST_DATABASE_URL=postgres://koltuk:sifre@127.0.0.1:5432/koltuk_test
# ADMIN_PASSWORD=  (npm run create-admin için, en az 12 karakter)
